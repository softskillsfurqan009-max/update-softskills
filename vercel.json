{
  "version": 2,
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/static/zpic.jpeg"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/fonts/(.*)",
      "dest": "/fonts/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}